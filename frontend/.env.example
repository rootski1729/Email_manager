# Where the backend API lives. The Next.js server proxies /api/* to this origin,
# so the browser only ever talks to the web origin (first-party refresh cookie).
# Read when `next build` runs: rewrites are baked into the build output.
API_ORIGIN=http://localhost:8000

# Cloudflare Turnstile site key for the sign-in form. Leave empty to disable.
# Must match the backend's Turnstile secret when set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Product name shown in the UI and page titles.
NEXT_PUBLIC_APP_NAME=MailSentinel

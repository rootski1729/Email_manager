# Application
APP_NAME="EmailFilter Pro"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY="your-secret-key-change-in-production"
ENVIRONMENT="development"

# Database
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/emailfilter"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_CELERY_DB=3

# JWT Authentication
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (for storing Google tokens)
ENCRYPTION_KEY="your-fernet-key-change-in-production"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
GOOGLE_PROJECT_ID="your-google-project-id"
GOOGLE_PUBSUB_TOPIC="gmail-notifications"

# WAHA (WhatsApp HTTP API) - Self-hosted WhatsApp service
WAHA_API_URL="http://localhost:3000/api"
WAHA_API_KEY="your-waha-api-key"
WAHA_SESSION_NAME="default"

# Legacy Twilio (deprecated - use WAHA instead)
# TWILIO_ACCOUNT_SID="your-twilio-account-sid"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Email (optional - only needed for fallback notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="noreply@emailfilter.com"

# WhatsApp OTP Authentication
WHATSAPP_OTP_ENABLED=true
WHATSAPP_OTP_EXPIRY_MINUTES=2
WHATSAPP_OTP_LENGTH=6

# Celery
CELERY_BROKER_URL="redis://localhost:6379/3"
CELERY_RESULT_BACKEND="redis://localhost:6379/3"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
WEBHOOK_RATE_LIMIT=1000

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Sentry
SENTRY_DSN=""

# Feature Flags
ENABLE_WHATSAPP_NOTIFICATIONS=False
ENABLE_EMAIL_DIGESTS=True
ENABLE_SIGNUP=True

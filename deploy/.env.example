# Copy to deploy/.env. Names only; generate real values (see `make secrets`). Never commit deploy/.env.
ENVIRONMENT=development
LOG_JSON=false

POSTGRES_USER=mailsentinel
POSTGRES_PASSWORD=
POSTGRES_DB=mailsentinel

# 32+ random bytes. `make secrets` prints fresh values for all of these.
JWT_SECRET=
# Comma separated Fernet keys; the first encrypts, all decrypt (rotate by prepending a new key).
ENCRYPTION_KEYS=

# Phones (E.164, comma separated) that become admins and may read their login code from logs
# before WhatsApp is paired.
ADMIN_PHONES=

PUBLIC_WEB_URL=http://localhost:3000
# When the web app proxies /api (Vercel rewrite), this can be the web origin too.
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# WAHA (WhatsApp HTTP API)
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WAHA_WEBHOOK_HMAC_KEY=
WAHA_SESSION=default
# true = log messages instead of sending (no phone needed)
WAHA_DRY_RUN=false

# Delivery limits (conservative defaults for one WhatsApp number)
RATE_GLOBAL_PER_MIN=20
RATE_GLOBAL_BURST=5
RATE_DESTINATION_PER_MIN=6

# Gmail (optional). OAuth redirect URI to register: ${PUBLIC_API_URL}/api/v1/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=gmail-notifications
GOOGLE_PUBSUB_SUBSCRIPTION=gmail-notifications-sub
# pull = gmail-listener container (no public URL needed); push = Pub/Sub POSTs to /api/v1/webhooks/gmail
GMAIL_PUSH_MODE=pull
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
GCP_PUBSUB_KEY_FILE=./secrets/gcp-pubsub.json

# Cloudflare Turnstile (optional)
TURNSTILE_SECRET=

# Production only: domain Caddy serves the API on
API_DOMAIN=
